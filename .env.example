# Copy this file to .env (or set env vars in your shell) before running.
# App network settings
PORT=80
HOST=0.0.0.0

# Log directory (relative path resolves from repo root)
LOGS_DIR=logs

# Optional global SSH defaults used when per-system fields are left blank
SSH_USERNAME=
SSH_PASSWORD=

# Optional command overrides
DEFAULT_PMUTIL_COMMAND=cd /root/apps/PI_PM/pmutil && ./pmutil_bin -i
DEFAULT_TURBOSTAT_COMMAND=cd /root/apps/PI_PM/turbostat && ./turbostat -q -s Package,Node,Core,CPU,Bzy_MHz,IPC,Busy%,CPU%c1,CPU%c6,C1E%,CoreTmp,PkgTmp,Pkg%pc2,Pkg%pc6,PkgWatt,RAMWatt,UncMHz,Mod%c6 -interval 1 -n 5
